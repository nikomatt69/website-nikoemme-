---
const stats = [
  { value: "5+", label: "Years shipping" },
  { value: "30+", label: "Open source repos" },
  { value: "∞", label: "Coffees consumed" },
];

const codeSnippet = `<span class="text-terminal-muted">// who am I</span>
<span class="text-blue-500">const</span> <span class="text-terminal-window-text">niko</span> = {
  <span class="text-terminal-accent">name</span>:      <span class="text-green-500">'Niko'</span>,
  <span class="text-terminal-accent">handle</span>:    <span class="text-green-500">'@nikomatt69'</span>,
  <span class="text-terminal-accent">role</span>:      <span class="text-green-500">'AI Engineer'</span>,
  <span class="text-terminal-accent">based</span>:     <span class="text-green-500">'Italy 🇮🇹'</span>,
  <span class="text-terminal-accent">loves</span>:     [<span class="text-green-500">'TS'</span>, <span class="text-green-500">'agents'</span>, <span class="text-green-500">'CLI'</span>],
  <span class="text-terminal-accent">currently</span>: <span class="text-green-500">'shipping nikcli'</span>,
} <span class="text-blue-500">as const</span>;`;
---

<section id="about" class="py-32 border-y border-terminal-border/60 bg-surface-hover/30">
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-terminal-accent/10 text-[11px] font-mono font-bold text-terminal-accent mb-6 uppercase tracking-widest border border-terminal-accent/20"
        >
          // about
        </div>
        <h2
          class="text-4xl md:text-5xl font-extrabold tracking-tight mb-6 text-terminal-text leading-[1.1]"
        >
          Builder. Engineer. Tinkerer.
        </h2>
        <div class="space-y-4 text-lg text-terminal-muted leading-relaxed font-medium">
          <p>
            I'm <span class="text-terminal-text font-bold">Niko</span>, an AI engineer
            and full-stack developer based in Italy. I obsess over developer
            ergonomics, terminal-native workflows and the kind of tools you actually
            want to open in the morning.
          </p>
          <p>
            I built <a
              href="https://github.com/nikomatt69/nikcli"
              target="_blank"
              rel="noreferrer"
              class="text-terminal-text underline underline-offset-4 decoration-terminal-border hover:decoration-terminal-accent hover:text-terminal-accent transition-colors font-semibold"
              >nikcli</a
            >, a provider-agnostic AI development agent that lives in your terminal.
            I write a lot of TypeScript, ship on Cloudflare, and care a little too
            much about font kerning.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-4">
          {
            stats.map((s) => (
              <div class="rounded-2xl p-5 bg-terminal-panel border border-terminal-border/80 dark:border-white/5 shadow-soft">
                <div class="text-3xl font-black tracking-tight text-terminal-text">
                  {s.value}
                </div>
                <div class="text-[12px] uppercase tracking-wider font-bold text-terminal-muted mt-1">
                  {s.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative">
        <div
          class="absolute -inset-4 bg-gradient-to-br from-terminal-accent/20 via-blue-500/10 to-transparent blur-3xl -z-10 opacity-60"
        >
        </div>
        <div
          class="rounded-[20px] overflow-hidden border border-terminal-window-border/80 dark:border-white/10 bg-terminal-window-bg shadow-strong"
        >
          <div
            class="flex items-center justify-between px-5 py-3.5 bg-gradient-to-b from-surface-hover to-terminal-window-bg border-b border-terminal-window-border/60"
          >
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-[#FF5F56] shadow-sm"></div>
              <div class="w-3 h-3 rounded-full bg-[#FFBD2E] shadow-sm"></div>
              <div class="w-3 h-3 rounded-full bg-[#27C93F] shadow-sm"></div>
            </div>
            <div
              class="text-[12px] font-mono font-medium text-terminal-muted px-3 py-1 rounded-md bg-surface-active/50 border border-terminal-border/30"
            >
              about.ts
            </div>
            <div class="w-12"></div>
          </div>
          <pre
            class="p-6 font-mono text-[13.5px] leading-relaxed bg-terminal-window-code overflow-x-auto"
          ><code set:html={codeSnippet}></code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
